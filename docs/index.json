ated","sources":[{"key":"gba_lod1","group":"data","title":"GlobalBuildingAtlas LoD1 footprints and heights","authors_or_publisher":"Technical University of Munich, on Source Cooperative","year":2025,"url":"https://source.coop/tge-labs/globalbuildingatlas-lod1","endpoint":"https://data.source.coop/tge-labs/globalbuildingatlas-lod1/{tile}.parquet","access":"anonymous","short":"GlobalBuildingAtlas LoD1, Source Cooperative","used_for":"Building footprints and heights. Chosen over Overture, which carried a height for 1 of 14,213 buildings in Ahmedabad. Tiled 5 degrees and read straight as GeoParquet, so one city needs one file rather than a global scan."},{"key":"copernicus_dem","group":"data","title":"Copernicus DEM GLO-30","authors_or_publisher":"European Space Agency, on AWS Open Data","release":"GLO-30 cloud-optimised GeoTIFF","licence":"Copernicus DEM licence","url":"https://registry.opendata.aws/copernicus-dem/","endpoint":"https://copernicus-dem-30m.s3.amazonaws.com/Copernicus_DSM_COG_10_{ns}{lat}_00_{ew}{lon}_00_DEM/Copernicus_DSM_COG_10_{ns}{lat}_00_{ew}{lon}_00_DEM.tif","access":"anonymous","short":"Copernicus DEM GLO-30, AWS Open Data","used_for":"Terrain in metres above sea level. Tiled 1 degree, read as a windowed cloud-optimised GeoTIFF, unsigned."},{"key":"esa_worldcover","group":"data","title":"ESA WorldCover 10 m land cover, 2021","authors_or_publisher":"European Space Agency, on AWS Open Data","year":2021,"release":"v200","licence":"CC BY 4.0","url":"https://esa-worldcover.org/","endpoint":"https://esa-worldcover.s3.amazonaws.com/v200/2021/map/ESA_WorldCover_10m_2021_v200_{ns}{lat}{ew}{lon}_Map.tif","access":"anonymous","short":"ESA WorldCover 10 m v200 2021, AWS Open Data","used_for":"Ground cover mapped onto the UMEP surface classes. Tiled 3 degrees, resampled nearest because a class code must never be interpolated."},{"key":"meta_wri_chm","group":"data","title":"Meta and WRI global canopy height model, 1 m","authors_or_publisher":"Meta and World Resources Institute, on AWS Open Data","year":2024,"release":"v1, alsgedi_global_v6_float","licence":"CC BY 4.0","url":"https://registry.opendata.aws/dataforgood-fb-forests/","endpoint":"https://dataforgood-fb-data.s3.amazonaws.com/forests/v1/alsgedi_global_v6_float/chm/{quadkey}.tif","access":"anonymous","short":"Meta and WRI 1 m canopy height, AWS Open Data","used_for":"Vegetation height above ground, the engine's canopy model. Tiled by quadkey against a global footprint index fetched once and cached."},{"key":"ghs_pop","group":"data","title":"GHS-POP population grid, 100 m, epoch 2020","authors_or_publisher":"European Commission, Joint Research Centre","year":2023,"release":"R2023A, E2020, 100 m, World Mollweide","licence":"CC BY 4.0","url":"https://human-settlement.emergency.copernicus.eu/ghs_pop2023.php","endpoint":"https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_POP_GLOBE_R2023A/GHS_POP_E2020_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_POP_E2020_GLOBE_R2023A_54009_100_V1_0_R{row}_C{col}.zip","access":"anonymous","short":"GHS-POP R2023A 100 m, JRC","used_for":"Population, redistributed across building volume, and the density scan that chooses study areas. Chosen over WorldPop, whose server refuses HTTP range requests and forces a whole-country download."},{"key":"ghs_built_s","group":"data","title":"GHS-BUILT-S built-up surface grid, 100 m, epoch 2020","authors_or_publisher":"European Commission, Joint Research Centre","year":2023,"release":"R2023A, E2020, 100 m, World Mollweide","licence":"CC BY 4.0","url":"https://human-settlement.emergency.copernicus.eu/ghs_buS2023.php","endpoint":"https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_BUILT_S_GLOBE_R2023A/GHS_BUILT_S_E2020_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_BUILT_S_E2020_GLOBE_R2023A_54009_100_V1_0_R{row}_C{col}.zip","access":"anonymous","short":"GHS-BUILT-S R2023A 100 m, JRC","used_for":"Built-up square metres per 100 m cell, summed per 1 km tile into the built fraction that stratifies tile selection."},{"key":"ghs_built_h","group":"data","title":"GHS-BUILT-H average net building height grid, 100 m, epoch 2018","authors_or_publisher":"European Commission, Joint Research Centre","year":2023,"release":"R2023A, ANBH E2018, 100 m, World Mollweide","licence":"CC BY 4.0","url":"https://human-settlement.emergency.copernicus.eu/ghs_buH2023.php","endpoint":"https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_BUILT_H_GLOBE_R2023A/GHS_BUILT_H_ANBH_E2018_GLOBE_R2023A_54009_100/V1-0/tiles/GHS_BUILT_H_ANBH_E2018_GLOBE_R2023A_54009_100_V1_0_R{row}_C{col}.zip","access":"anonymous","short":"GHS-BUILT-H R2023A 100 m, JRC","used_for":"Average net building height per 100 m cell, averaged over built cells per tile to describe a tile's morphology before it is built."},{"key":"open_meteo_era5","group":"data","title":"Open-Meteo historical weather API, ERA5 reanalysis","authors_or_publisher":"Open-Meteo","release":"ERA5 through the archive API","licence":"CC BY 4.0","url":"https://open-meteo.com/en/docs/historical-weather-api","endpoint":"https://archive-api.open-meteo.com/v1/archive","access":"anonymous","short":"Open-Meteo ERA5 archive, no key","used_for":"Hourly meteorology for the design day: temperature_2m, relative_humidity_2m, wind_speed_10m, wind_direction_10m, surface_pressure, shortwave_radiation, direct_radiation, diffuse_radiation. Chosen over Copernicus CDS, which needs an account and a credentials file."},{"key":"osm_overpass","group":"data","title":"OpenStreetMap, via the Overpass API","authors_or_publisher":"OpenStreetMap contributors","licence":"ODbL 1.0","url":"https://www.openstreetmap.org/copyright","endpoint":"https://overpass-api.de/api/interpreter","access":"anonymous","short":"OpenStreetMap via Overpass","used_for":"The walkable network behind the corridor objective, queried through OSMnx and cached as GraphML per study area because Overpass is a shared free service."},{"key":"ghs_ucdb","group":"data","title":"GHS Urban Centre Database R2024A","authors_or_publisher":"European Commission, Joint Research Centre","year":2024,"release":"R2024A V1_2","licence":"CC BY 4.0","url":"https://human-settlement.emergency.copernicus.eu/ucdb2024Overview.php","endpoint":"https://jeodpp.jrc.ec.europa.eu/ftp/jrc-opendata/GHSL/GHS_UCDB_GLOBE_R2024A/GHS_UCDB_THEME_GLOBE_R2024A/GHS_UCDB_THEME_{theme}_GLOBE_R2024A/V1-2/GHS_UCDB_THEME_{theme}_GLOBE_R2024A_V1_2.zip","access":"anonymous","short":"GHS-UCDB R2024A, JRC","used_for":"The corpus: 11,422 urban centres with name, country, population, area, World Bank income group and Koppen-Geiger class, and the polygons whose 1 km cells are the benchmark's tiles. Its population is the zonal sum of GHS-POP R2023A inside the boundary for the 2025 epoch, a modelled projection rather than a count; summing that epoch over Ahmedabad's 365 cells reproduces the database figure to the person."},{"key":"koppen_beck_2018","group":"data","title":"Present and future K\u00f6ppen-Geiger climate classification maps at 1-km resolution","authors_or_publisher":"Beck et al., Scientific Data 5, 180214","year":2018,"licence":"CC BY 4.0","doi":"10.1038/sdata.2018.214","url":"https://www.gloh2o.org/koppen/","access":"anonymous","via":"ghs_ucdb","short":"K\u00f6ppen-Geiger 1 km maps, Beck et al. 2018","used_for":"The Koppen class of each urban centre, as the class covering the majority of its surface, reached through GHS-UCDB."},{"key":"world_bank_income","group":"data","title":"World Bank country and lending groups","authors_or_publisher":"The World Bank","year":2022,"release":"2022 classification, as carried by GHS-UCDB","licence":"CC BY 4.0","url":"https://datahelpdesk.worldbank.org/knowledgebase/articles/906519","access":"anonymous","via":"ghs_ucdb","short":"World Bank income groups, via GHS-UCDB","used_for":"The income stratum of each urban centre, joined by country, reached through GHS-UCDB."},{"key":"natural_earth_admin0","group":"data","title":"Natural Earth admin-0 countries, 1:50m","authors_or_publisher":"Natural Earth","release":"5.1.1","licence":"Public domain","url":"https://www.naturalearthdata.com/downloads/50m-cultural-vectors/","endpoint":"https://naciscdn.org/naturalearth/50m/cultural/ne_50m_admin_0_countries.zip","access":"anonymous","short":"Natural Earth countries 1:50m","used_for":"Continent, UN subregion and ISO3 code of each urban centre, by spatial join of its centroid, for corpus statistics. Names are never matched."}]},{"key":"validation","title":"Validation, the one source outside the credential-free path","sources":[{"key":"landsat_c2l2","group":"validation","title":"Landsat Collection 2 Level 2 surface temperature","authors_or_publisher":"United States Geological Survey, via Microsoft Planetary Computer","release":"Collection 2 Level 2, asset lwir11","licence":"Public domain, USGS","url":"https://planetarycomputer.microsoft.com/dataset/landsat-c2-l2","endpoint":"https://planetarycomputer.microsoft.com/api/stac/v1","access":"token broker","short":"Landsat C2 L2 surface temperature, Planetary Computer","used_for":"Checks that simulated heat lands where the satellite saw heat, never to build a bundle. Reached through a broker that signs each request with a short-lived token, so this is the one place a broker sits in the path."}]},{"key":"method","title":"Method","sources":[{"key":"osmnx_2017","group":"method","title":"OSMnx: new methods for acquiring, constructing, analyzing and visualizing complex street networks","authors_or_publisher":"Boeing, Computers, Environment and Urban Systems 65","year":2017,"doi":"10.1016/j.compenvurbsys.2017.05.004","used_for":"Fetches and projects the walk network."},{"key":"unet_2015","group":"method","title":"U-Net: convolutional networks for biomedical image segmentation","authors_or_publisher":"Ronneberger, Fischer and Brox, MICCAI","year":2015,"url":"https://arxiv.org/abs/1505.04597","used_for":"The surrogate architecture."},{"key":"esp_2020","group":"method","title":"Evolutionary surrogate-assisted prescription","authors_or_publisher":"Cognizant AI Labs","year":2020,"url":"https://arxiv.org/pdf/2012.10504","used_for":"The framing behind treating this as a prescriptor over a learned predictor."},{"key":"en_roads_py","group":"method","title":"en-roads-py, evolutionary prescription applied to En-ROADS","authors_or_publisher":"Cognizant AI Labs","url":"https://github.com/cognizant-ai-labs/en-roads-py","used_for":"A working implementation of the prescriptor pattern over a fixed simulator, and the closest existing analogue to what the planner here does over SOLWEIG."}]}]}